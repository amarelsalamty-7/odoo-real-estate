<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="property_views_tree" model="ir.ui.view">
        <field name="name">property.tree</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <tree class="header_custom" decoration-danger="is_late">
                <field name="ref"/>
                <field name="name"/>
                <field name="date_availability"/>
                <field name="is_late" column_invisible="1"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="garden"/>
                <field name="postcode" optional="hide"/>
                <field name="living_room" optional="hide"/>
                <field name="facades" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'sold'"/>
            </tree>
        </field>
    </record>

    <record id="property_views_form" model="ir.ui.view">
        <field name="name">property.form</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pending" type="object" class="btn-secondary"
                            string="Set to Pending" invisible="state != 'draft'"/>
                    <button name="action_sold" type="object" class="btn-success"
                            string="Mark as Sold" invisible="state != 'pending'"/>
                    <button name="action_closed" type="object" class="btn-secondary"
                            string="Close" invisible="state != 'sold'"/>
                    <button name="action_draft" type="object" class="btn-primary"
                            string="Reset to Draft" invisible="state in ('draft', 'closed')"/>
                    <button name="action_open_change_state_wizard" type="object" class="btn-primary"
                            string="Re-open" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,sold,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="ref"/>
                        <h1><field name="ref"/></h1>
                        <label for="name"/>
                        <h3><field name="name"/></h3>
                    </div>
                    <group>
                        <group string="General Info.">
                            <field name="date_availability" required="1"/>
                            <field name="expected_selling_date"/>
                            <field name="is_late" invisible="1"/>
                            <field name="expected_price"/>
                            <field name="selling_price"/>
                            <field name="diff"/>
                            <field name="active"/>
                        </group>
                        <group string="Additional Info.">
                            <field name="postcode"/>
                            <field name="owner_id"/>
                            <field name="owner_address"/>
                            <field name="owner_phone"/>
                            <field name="bedrooms"/>
                            <field name="living_room"/>
                            <field name="facades"/>
                            <field name="garage"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Garden">
                            <field name="garden"/>
                            <field name="garden_area" invisible="not garden"/>
                            <field name="garden_orientation" invisible="not garden"/>
                        </group>
                        <group string="Description">
                            <field name="description" required="1" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rooms">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="description"/>
                                    <field name="area"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="property_views_search" model="ir.ui.view">
        <field name="name">property.search</field>
        <field name="model">property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="postcode"/>
                <field name="owner_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_sold" string="Sold" domain="[('state', '=', 'sold')]"/>
                <separator/>
                <filter name="is_garden" string="With Garden" domain="[('garden', '=', True)]"/>
                <filter name="is_garage" string="With Garage" domain="[('garage', '=', True)]"/>
                <filter name="is_not_garden" string="Without Garden" domain="[('garden', '=', False)]"/>
                <filter name="is_late_filter" string="Late" domain="[('is_late', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_garden" string="Garden" context="{'group_by': 'garden'}"/>
                    <filter name="group_owner" string="Owner" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first property</p>
        </field>
    </record>

    <record id="property_closed_server_action" model="ir.actions.server">
        <field name="name">Close</field>
        <field name="model_id" ref="model_property"/>
        <field name="binding_model_id" ref="model_property"/>
        <field name="state">code</field>
        <field name="code">records.action_closed()</field>
    </record>

    <record id="list_view_action" model="ir.actions.client">
        <field name="name">Properties (OWL)</field>
        <field name="tag">real_estate.action_list_view</field>
    </record>

    <menuitem id="property_menu_item"
              name="Properties"
              parent="properties_menu"
              action="property_action"
              sequence="10"/>
    <menuitem id="property_list_view_menu_item"
              name="Properties (OWL)"
              parent="properties_menu"
              action="list_view_action"
              sequence="30"/>
</odoo>
