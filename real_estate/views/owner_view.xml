<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="owner_views_tree" model="ir.ui.view">
        <field name="name">owner.tree</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="name"/>
                <field name="phone"/>
                <field name="address"/>
            </tree>
        </field>
    </record>

    <record id="owner_views_form" model="ir.ui.view">
        <field name="name">owner.form</field>
        <field name="model">owner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="phone"/>
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Properties">
                            <field name="property_ids" readonly="1">
                                <tree>
                                    <field name="ref"/>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="expected_price"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="owner_action" model="ir.actions.act_window">
        <field name="name">Owners</field>
        <field name="res_model">owner</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="owner_menu_item"
              name="Owners"
              parent="configuration_menu"
              action="owner_action"
              sequence="10"/>
</odoo>
