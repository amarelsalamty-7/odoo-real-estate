<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="building_views_tree" model="ir.ui.view">
        <field name="name">building.tree</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <tree class="header_custom">
                <field name="no"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="building_views_form" model="ir.ui.view">
        <field name="name">building.form</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="General Info.">
                            <field name="no"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group string="Additional Info.">
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="building_views_search" model="ir.ui.view">
        <field name="name">building.search</field>
        <field name="model">building</field>
        <field name="arch" type="xml">
            <search>
                <field name="no"/>
                <field name="code"/>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="building_action" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">building</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="building_menu_item"
              name="Buildings"
              parent="properties_menu"
              action="building_action"
              sequence="20"/>
</odoo>
