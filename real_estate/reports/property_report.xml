<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="property_report" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">real_estate.property_report_template</field>
        <field name="report_file">real_estate.property_report_template</field>
        <field name="print_report_name">'Property - %s' % (object.ref or 'New')</field>
        <field name="binding_model_id" ref="model_property"/>
        <field name="binding_type">report</field>
    </record>

    <template id="property_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <style>
                    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
                    table, th, td { border: 1px solid #000; }
                    th, td { padding: 8px; text-align: left; }
                    th { background-color: #f2f2f2; }
                    tbody tr:nth-child(odd) { background-color: #f9f9f9; }
                </style>
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <h1 style="font-family:'WinkyRough';">Property Report</h1>
                        <table>
                            <thead>
                                <tr><th colspan="4">General Information</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Reference</td><td><t t-out="o.ref"/></td>
                                    <td>Name</td><td><t t-out="o.name"/></td>
                                </tr>
                                <tr>
                                    <td>Postcode</td><td><t t-out="o.postcode"/></td>
                                    <td>Status</td><td><t t-out="o.state"/></td>
                                </tr>
                                <tr>
                                    <td>Expected price</td><td><t t-out="o.expected_price"/></td>
                                    <td>Selling price</td><td><t t-out="o.selling_price"/></td>
                                </tr>
                            </tbody>
                            <thead>
                                <tr><th colspan="4">Additional Information</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Owner</td><td><t t-out="o.owner_id.name"/></td>
                                    <td>Phone</td><td><t t-out="o.owner_phone"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table>
                            <thead>
                                <tr><th>Description</th><th>Area (m²)</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-out="line.description"/></td>
                                        <td><t t-out="line.area"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
